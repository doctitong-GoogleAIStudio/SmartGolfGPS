# Existing Laravel API root, including /api or a version prefix if applicable.
# No backend is selected until the owner supplies the endpoint and contract.
EXPO_PUBLIC_API_URL=

# Optional licensed raster provider. Only use public/restricted client tokens.
EXPO_PUBLIC_IMAGERY_TILE_URL=
EXPO_PUBLIC_IMAGERY_ATTRIBUTION=
EXPO_PUBLIC_IMAGERY_LICENSE_REFERENCE=
# Enable only when the actual provider agreement permits offline tile packs.
EXPO_PUBLIC_IMAGERY_OFFLINE_ALLOWED=false
EXPO_PUBLIC_IMAGERY_TRACING_ALLOWED=false
